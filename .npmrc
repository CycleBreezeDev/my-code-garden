# react-day-picker@8 declares date-fns ^2 || ^3 as a peer dep, while
# this project uses date-fns@^4 elsewhere. The library still works
# fine at runtime against v4, but strict peer resolution (`npm ci`)
# refuses the install. Vercel uses `npm ci`, so allow legacy peer
# resolution to keep deploys green until react-day-picker@9 lands.
legacy-peer-deps=true
