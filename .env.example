# =====================================================================
# Frontend (Vite) — required for build & runtime on Vercel
# Add these in Vercel: Project → Settings → Environment Variables
# (Production, Preview, and Development scopes)
# ---------------------------------------------------------------------
# Find these in Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# =====================================================================
# Supabase Edge Function secrets — set with `supabase secrets set …`
# (NOT exposed to the browser; do NOT prefix with VITE_)
# ---------------------------------------------------------------------
# Auto-injected by Supabase at runtime — listed for documentation only:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Manually set per environment:
PAYSTACK_SECRET_KEY="sk_test_xxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxx"
FLUTTERWAVE_WEBHOOK_HASH="your-flutterwave-verifhash"
LOVABLE_API_KEY=""
LOVABLE_SEND_URL=""
FIRECRAWL_API_KEY=""
GITHUB_PAT=""
GITHUB_REPO="owner/repo"

# Optional — populated by Vercel automatically inside the build:
# VERCEL_GIT_COMMIT_SHA
